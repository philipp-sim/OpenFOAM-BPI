FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "${FOAM_CASE}/constant/initialisationConditions"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $!internalField/T;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform $!atmosphere/T;
        inlet	    	uniform $!atmosphere/T;
    }

    /*staticWalls
    {
        type            fixedValue;
	value uniform $!surface/T;
    }*/

    window
    {
        type zeroGradient;
    }
    
    glass_master
    {
    type            compressible::thermalBaffle1D<eConstSolidThermoPhysics>;

    neighbourPatch  glass_slave;

    thickness       uniform 0.004;     // 4mm Glasdicke
    qs              uniform 0;         // Keine interne Wärmequelle
    qr              none;              // Keine Strahlung
    qrRelaxation    1;
    value           uniform $!surface/T;
    
    specie // Floatglas-Eigenschaften:
    {
        molWeight       60.08;         // SiO2 Molgewicht
    }
    transport
    {
        kappa           0.010;           // Wärmeleitfähigkeit [W/(m·K)]
    }
    thermodynamics
    {
        hf              0;             // Bildungsenthalpie
        Cv              840;           // Spezifische Wärmekapazität [J/(kg·K)]
    }
    equationOfState
    {
        rho             2500;          // Dichte [kg/m³]
    }
    }

    glass_slave
    {
        type            compressible::thermalBaffle1D<eConstSolidThermoPhysics>;
        neighbourPatch  glass_master;
        qr              none;
        relaxation      1;
        value           uniform $!surface/T;
    }

    walls
    {
        type            fixedValue;
	    value uniform $!surface/T;
    }

    //staticWalls
    /*walls
    {
	type codedFixedValue;
        value uniform $!surface/T;
	name thermoWall;

        codeOptions
        #{
            -I"../../include"
        #};
        codeInclude
        #{
            #include "thermoWallCode.H"
        #};

        code
        #{
            
            scalar rho = 2000.0;    // kg/m3 (concrete)
            scalar cp = 1000.0;     // J/(kg K) thermal capacity
            scalar d = 0.2;         // m (thickness of wall)
            updateThermoWall(*this, rho, cp, d);
        #};
    }*/



    movingWalls
    {
        type zeroGradient;
    }

    nonCouple
    {
        type            zeroGradient;
    }

    ".*"
    {
        type            zeroGradient;
    }
}

