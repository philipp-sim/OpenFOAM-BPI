FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 3.971e-05;

boundaryField
{
    innerInlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    atmosphere_outlet
    {
        type            calculated;
        value           uniform 3.971e-05;
    }
    walls
    {
        type            nutkWallFunction;
        value           uniform 3.971e-05;
    }
    window
    {
        type            nutkWallFunction;
        value           uniform 3.971e-05;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform 3.971e-05;
    }
    procBoundary1to2
    {
        type            processor;
        value           uniform 3.971e-05;
    }
    procBoundary1to3
    {
        type            processor;
        value           uniform 3.971e-05;
    }
    procBoundary1to6
    {
        type            processor;
        value           uniform 3.971e-05;
    }
}


