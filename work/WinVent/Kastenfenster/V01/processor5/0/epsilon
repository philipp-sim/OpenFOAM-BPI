FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 6e-05;

boundaryField
{
    innerInlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            epsilonWallFunction;
        value           uniform 6e-05;
    }
    window
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0();
    }
    procBoundary5to0
    {
        type            processor;
        value           uniform 6e-05;
    }
    procBoundary5to4
    {
        type            processor;
        value           uniform 6e-05;
    }
    procBoundary5to6
    {
        type            processor;
        value           uniform 6e-05;
    }
    procBoundary5to7
    {
        type            processor;
        value           uniform 6e-05;
    }
}


