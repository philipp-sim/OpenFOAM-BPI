FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 283.15;

boundaryField
{
    innerInlet
    {
        type            inletOutlet;
        inletValue      uniform 283.15;
        value           uniform 283.15;
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      uniform 283.15;
        value           uniform 283.15;
    }
    walls
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    window
    {
        type            zeroGradient;
    }
    procBoundary3to0
    {
        type            processor;
        value           uniform 283.15;
    }
    procBoundary3to1
    {
        type            processor;
        value           uniform 283.15;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 283.15;
    }
}


