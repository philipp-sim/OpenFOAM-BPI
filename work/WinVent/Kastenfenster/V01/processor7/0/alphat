FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 3.971e-05;

boundaryField
{
    innerInlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    atmosphere_outlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            compressible::alphatJayatillekeWallFunction;
        Prt             0.85;
        value           uniform 1e-11;
    }
    window
    {
        type            compressible::alphatJayatillekeWallFunction;
        Prt             0.85;
        value           nonuniform List<scalar> 0();
    }
    procBoundary7to4
    {
        type            processor;
        value           uniform 3.971e-05;
    }
    procBoundary7to5
    {
        type            processor;
        value           uniform 3.971e-05;
    }
    procBoundary7to6
    {
        type            processor;
        value           uniform 3.971e-05;
    }
}


