    {
        type            inletOutlet;
        inletValue      uniform 0.00610422;
        value           uniform 0.00610422;
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.00610422;
        value           uniform 0.00610422;
    }
    walls
    {
        type            zeroGradient;
    }
    window
    {
        type            zeroGradient;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 0.00610422;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.00610422;
    }
}


