FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    innerInlet
    {
        type            pressureInletOutletVelocity;
        value           nonuniform List<vector> 0();
    }
    atmosphere_outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    walls
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    window
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to5
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary0to6
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


