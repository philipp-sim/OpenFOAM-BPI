FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    atmosphere_ground
    {
        type            calculated;
        value           uniform 101325;
    }
    atmosphere_outlet
    {
        type            calculated;
        value           uniform 101325;
    }
    walls
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    outflow
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    glass_inside_master
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    glass_inside_slave
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    glass_outside_master
    {
        type            calculated;
        value           uniform 101325;
    }
    glass_outside_slave
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 101325;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 101325;
    }
}


