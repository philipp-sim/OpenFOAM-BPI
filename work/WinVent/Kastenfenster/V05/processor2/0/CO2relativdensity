        type            zeroGradient;
    }
    outflow
    {
        type            zeroGradient;
    }
    glass_inside_master
    {
        type            zeroGradient;
    }
    glass_inside_slave
    {
        type            zeroGradient;
    }
    glass_outside_master
    {
        type            zeroGradient;
    }
    glass_outside_slave
    {
        type            zeroGradient;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 0.0007031;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.0007031;
    }
