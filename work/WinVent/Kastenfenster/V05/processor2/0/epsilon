FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 5.7e-05;

boundaryField
{
    atmosphere_ground
    {
        type            inletOutlet;
        inletValue      uniform 5.7e-05;
        value           uniform 5.7e-05;
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      uniform 5.7e-05;
        value           uniform 5.7e-05;
    }
    walls
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0();
    }
    outflow
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    glass_inside_master
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0();
    }
    glass_inside_slave
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0();
    }
    glass_outside_master
    {
        type            epsilonWallFunction;
        value           uniform 5.7e-05;
    }
    glass_outside_slave
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0();
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 5.7e-05;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 5.7e-05;
    }
}


