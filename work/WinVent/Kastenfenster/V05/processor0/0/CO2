FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      CO2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 400;

boundaryField
{
    atmosphere_ground
    {
        type            inletOutlet;
        inletValue      uniform 400;
        value           uniform 400;
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      uniform 400;
        value           uniform 400;
    }
    walls
    {
        type            zeroGradient;
    }
    outflow
    {
        type            zeroGradient;
    }
    glass_inside_master
    {
        type            zeroGradient;
    }
    glass_inside_slave
    {
        type            zeroGradient;
    }
    glass_outside_master
    {
        type            zeroGradient;
    }
    glass_outside_slave
    {
        type            zeroGradient;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 400;
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform 400;
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform 400;
    }
    procBoundary0to6
    {
        type            processor;
        value           uniform 400;
    }
    procBoundary0to7
    {
        type            processor;
        value           uniform 400;
    }
}


