FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    atmosphere_ground
    {
        type            pressureInletOutletVelocity;
        value           nonuniform List<vector> 0();
    }
    atmosphere_outlet
    {
        type            pressureInletOutletVelocity;
        value           nonuniform List<vector> 0();
    }
    walls
    {
        type            noSlip;
    }
    outflow
    {
        type            fixedValue;
        value           nonuniform List<vector> 0();
    }
    glass_inside_master
    {
        type            noSlip;
    }
    glass_inside_slave
    {
        type            noSlip;
    }
    glass_outside_master
    {
        type            noSlip;
    }
    glass_outside_slave
    {
        type            noSlip;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary1to6
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary1to7
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


