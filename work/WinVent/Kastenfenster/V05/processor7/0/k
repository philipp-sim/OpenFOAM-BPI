FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.4e-05;

boundaryField
{
    atmosphere_ground
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform 2.4e-05;
    }
    outflow
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    glass_inside_master
    {
        type            kqRWallFunction;
        value           nonuniform List<scalar> 0();
    }
    glass_inside_slave
    {
        type            kqRWallFunction;
        value           uniform 2.4e-05;
    }
    glass_outside_master
    {
        type            kqRWallFunction;
        value           nonuniform List<scalar> 0();
    }
    glass_outside_slave
    {
        type            kqRWallFunction;
        value           nonuniform List<scalar> 0();
    }
    procBoundary7to0
    {
        type            processor;
        value           uniform 2.4e-05;
    }
    procBoundary7to1
    {
        type            processor;
        value           uniform 2.4e-05;
    }
    procBoundary7to6
    {
        type            processor;
        value           uniform 2.4e-05;
    }
}


