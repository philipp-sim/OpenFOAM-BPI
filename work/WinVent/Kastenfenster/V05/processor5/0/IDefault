FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      IDefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    atmosphere_ground
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           nonuniform List<scalar> 0();
    }
    atmosphere_outlet
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           uniform 0;
    }
    outflow
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           uniform 0;
    }
    glass_inside_master
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           uniform 0;
    }
    glass_inside_slave
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           nonuniform List<scalar> 0();
    }
    glass_outside_master
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           nonuniform List<scalar> 0();
    }
    glass_outside_slave
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 1;
        value           nonuniform List<scalar> 0();
    }
    procBoundary5to4
    {
        type            processor;
        value           uniform 0;
    }
}


