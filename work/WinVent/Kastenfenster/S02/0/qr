FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      qr;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];  // W/m²

internalField   uniform 200;  // Fester Strahlungswärmestrom [W/m²]

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            calculated;
        value           uniform 0;
    }

    outflow
    {
        type            calculated;
        value           uniform 0;
    }

    "glass_.*"
    {
        type            fixedValue;
        value           uniform 0;  // Strahlungswärmestrom auf der Außenseite
    }
    
    staticWalls
    {
        type            fixedValue;
        value           uniform 0;
    }

    "window|window_refinement"
    {
        $staticWalls;
    }

    /*".*"
    {
        type            zeroGradient;
    }*/
}

// ************************************************************************* //