FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "${FOAM_CASE}/constant/initialisationConditions"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $!internalField/T;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform $!atmosphere/T;
        inlet	    	uniform $!atmosphere/T;
    }

    outflow
    {
        type            inletOutlet;
        inletValue      $internalField;
        inlet	    	$internalField;
    }

    staticWalls
    {
        type            fixedValue;
	    value           uniform $!surface/T;
    }
    
    window 
    {
        type            zeroGradient;
    }

    glassWalls
    {
        type            compressible::thermalBaffle1D<eConstSolidThermoPhysics>;
        thickness       uniform 0.006; // 6mm floatglass
        qs              uniform 0;
        qr              none;
        qrRelaxation    1;
        
        specie
        {
            molWeight       60.08; //molweight of SiO2
        }
        transport
        {
            kappa           1; // W/(m K)
        }
        thermodynamics
        {
            hf              0;
            Cv              840; // specific heat capacity [J/(kg K)
        }
        equationOfState
        {
            rho             2500;
        }
    }
    
     
    glass_outside_top_master
    {
        $glassWalls;
        neighbourPatch  glass_outside_top_slave;
        value           uniform $!atmosphere/T;
    }

    glass_outside_top_slave
    {
        $glassWalls;
        neighbourPatch  glass_outside_top_master;
        value           uniform $!atmosphere/T;
    } 
    
    glass_outside_bottom_master
    {
        $glassWalls;
        neighbourPatch  glass_outside_bottom_slave;
        value           uniform $!atmosphere/T;
    }

    glass_outside_bottom_slave
    {
        $glassWalls;
        neighbourPatch  glass_outside_bottom_master;
        value           uniform $!atmosphere/T;
    } 

    glass_inside_top_master
    {
        $glassWalls;
        neighbourPatch  glass_inside_top_slave;
        value           $internalField;
    }

    glass_inside_top_slave
    {
        $glassWalls;
        neighbourPatch  glass_inside_top_master;
        value           $internalField;
    }

    glass_inside_bottom_master
    {
        $glassWalls;
        neighbourPatch  glass_inside_bottom_slave;
        value           $internalField;
    }

    glass_inside_bottom_slave
    {
        $glassWalls;
        neighbourPatch  glass_inside_bottom_master;
        value           $internalField;
    }

    /*".*"
    {
        type            zeroGradient;
    }*/
}

