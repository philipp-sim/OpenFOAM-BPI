FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            pressureInletOutletVelocity;
        inletValue      $internalField;
        value           $internalField;
    }

    staticWalls
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    window
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    glass_outside_master
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    glass_outside_slave
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    outflow
    {
        //type            zeroGradient;
        type            fixedValue;
        value           uniform (0 0.2778 0);

        // value should be 20m³/h through the window
        // Outflow area = 0.02 m2 (1m * 0.02m)
        // velocity = flowrate/area = 20/3600 / 0.02 = 0.2778 m/s

    }

    ".*"
    {
        type            zeroGradient;
    }
}

