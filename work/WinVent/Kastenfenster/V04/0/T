FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293.15;

boundaryField
{
    atmosphere_ground
    {
        type            inletOutlet;
        inletValue      uniform 293.15;
        value           uniform 293.15;
    }
    atmosphere_outlet
    {
        type            inletOutlet;
        inletValue      uniform 293.15;
        value           uniform 293.15;
    }
    walls
    {
        type            fixedValue;
        value           uniform 293.15;
    }
    window
    {
        type            zeroGradient;
    }
    outflow
    {
        type            inletOutlet;
        inletValue      uniform 293.15;
        value           uniform 293.15;
    }
    glass_inside_master
    {
        type            zeroGradient;
    }
    glass_inside_slave
    {
        type            zeroGradient;
    }
    glass_outside_master
    {
        type            zeroGradient;
    }
    glass_outside_slave
    {
        type            zeroGradient;
    }
}


