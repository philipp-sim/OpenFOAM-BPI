FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            prghTotalHydrostaticPressure;
        p0              $internalField;
        gamma           1;
        value           $internalField;
    }

    staticWalls
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    outflow
    {
        type            prghTotalHydrostaticPressure;
        p0              $internalField;
        gamma           1;
        value           $internalField;
    }

    "(glass_inside_master|glass_inside_slave|glass_outside_master|glass_outside_slave)"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    /*".*"
    {
        type            zeroGradient;
    }*/
}

