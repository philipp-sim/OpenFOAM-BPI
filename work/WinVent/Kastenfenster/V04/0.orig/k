FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.40e-5;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $inletValue;
    }

    outflow
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $inletValue;
    }

    staticWalls
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    "(glass_inside_master|glass_inside_slave|glass_outside_master|glass_outside_slave)"
    {
        type            kqRWallFunction;
        value           $internalField;
        //type            kLowReWallFunction;
        //value           uniform 1e-10;
    }

    /*".*"
    {
        type            zeroGradient;
    }*/
}

