FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "${FOAM_CASE}/constant/initialisationConditions"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $!internalField/T;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform $!atmosphere/T;
        inlet	    	uniform $!atmosphere/T;
    }

    glass_outside_master
    {
        type   compressible::thermalBaffle1D<eConstSolidThermoPhysics>;
        neighbourPatch  glass_outside_slave;
        thickness       uniform 0.006;  // Glasdicke [m]
        qs              uniform 0;     // Wärmefluss [W/m^2] - 0 für kein Heizen
        qr              none;
        qrRelaxation    1;
        // Solid thermo für Glas
        specie
        {
            molWeight       60;  // Mittleres Molekulargewicht für Glas
        }
        transport
        {
            kappa           0.0021;  // Wärmeleitfähigkeit [W/m/K] U-Value 0.35W/m²K * 0.006m = 0.0021W/mK
        }
        thermodynamics
        {
            hf              0;
            Cv              750;  // Spezifische Wärmekapazität [J/kg/K]
        }
        equationOfState
        {
            rho             2500; // Dichte [kg/m^3]
        }

        value           uniform 293;  // Anfangstemperatur [K]
    }

    glass_outside_slave
    {
        type   compressible::thermalBaffle1D<eConstSolidThermoPhysics>;
        neighbourPatch  glass_outside_master;
        qr              none;
        relaxation      1;
        value           uniform 293;  // Anfangstemperatur [K]
    }

    staticWalls
    {
        type            fixedValue;
	    value           uniform $!surface/T;
    }

    /*glass_outside
